{
  "name": "lantai-ui",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Wenbing Jing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite",
    "build": "node ../scripts/build-builtin-plugins.mjs && tsc --noEmit && cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:builtin-plugins": "node ../scripts/build-builtin-plugins.mjs",
    "format": "biome format --write .",
    "lint": "biome check --fix .",
    "check": "biome ci .",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:tool-contract": "node ../scripts/gen-tool-contract-md.cjs",
    "check:tool-contract": "node ../scripts/gen-tool-contract-md.cjs --check",
    "gen:engine-contract": "node ../scripts/gen-engine-plugin-contract.cjs",
    "check:engine-contract": "node ../scripts/gen-engine-plugin-contract.cjs --check",
    "gen:catalogs": "node ../scripts/regen-catalogs.cjs",
    "test:convergence": "vitest run tests/convergence",
    "verify:convergence": "node tests/convergence/gate.mjs check",
    "record:convergence": "cross-env CONVERGENCE_RECORD=1 node tests/convergence/gate.mjs record",
    "report:convergence": "node tests/convergence/gate.mjs report",
    "gen:catalogs:service": "node ../scripts/gen-service-catalog.cjs",
    "gen:catalogs:event": "node ../scripts/gen-event-catalog.cjs",
    "doc-sync": "node ../scripts/doc-sync.cjs",
    "gen:contract-fingerprint": "node ../scripts/gen-contract-fingerprint.cjs",
    "check:contract-fingerprint": "node ../scripts/gen-contract-fingerprint.cjs --check"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@react-aria/combobox": "^3.16.1",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/listbox": "^3.16.1",
    "@react-stately/combobox": "^3.14.1",
    "@tanstack/react-virtual": "^3.14.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/three": "^0.185.1",
    "echarts": "^6.1.0",
    "gpt-tokenizer": "^3.4.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.6",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-stately": "^3.49.0",
    "remark-gfm": "^4.0.1",
    "smiles-drawer": "^2.4.1",
    "three": "^0.185.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@webgpu/types": "^0.1.70",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.0",
    "vite": "^6.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  }
}
